         <pdfx:ecv-data>{"_id":"6756a3be70436d47db4bd971","style":{"layoutSize":"medium","background":null,"colors":["#002B7F","#F96B07"],"fontBody":"opensans","fontHeading":"montserratlocked","fontSize":1,"isMetaDataDisabled":false,"layout":"timeline","lineHeightOption":0,"marginOption":1,"pageMarginOption":1,"record":"ResumeStyle"},"header":{"email":"sleimannader73@gmail.com","extraField":"","extraLink":"","height":99,"customHeight":188,"contacts":"","link":"www.linkedin.com/in/nader-sleiman-246a97223","location":"Beirut","name":"Nader Sleiman","phone":"+9613844060","photo":"","photoStyle":"round","record":"Header","showEmail":true,"showExtraField":false,"showExtraLink":false,"showLink":true,"showLocation":true,"showPhone":true,"showPhoto":false,"showTitle":true,"title":"Senior Graphic Designer","uppercaseName":true},"sections":[{"__t":"ExperienceSection","timelineWidth":175,"showCompanyLogos":false,"column":0,"enabled":true,"height":30,"items":[{"dateRange":{"fromMonth":0,"fromYear":2020,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":0,"toYear":2020},"table":{"cols":2,"record":"TableItem","rows":[]},"alignment":"left","bullets":["Lead a team of 5 designers in the creation and execution of visual branding and marketing materials for a diverse clientele","Conceptualize and design digital and print marketing campaigns, resulting in a 30% increase in client engagement","Collaborate with cross-functional teams to develop brand identities, ensuring consistency across all marketing channels","Manage multiple projects simultaneously, adhering to strict deadlines and budget constraints","Conduct market research and analyze trends to stay ahead of industry developments"],"companyLogo":"","description":"undefined","link":"","location":"Tayouneh, Beirut, Lebanon","position":"Senior Graphic Designer","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":false,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"Gcel mea","height":186,"id":"k0ll33fz3k","record":"ExperienceItem"},{"dateRange":{"fromMonth":5,"fromYear":2011,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":11,"toYear":2019},"table":{"cols":2,"record":"TableItem","rows":[]},"alignment":"left","bullets":["Designed and produced marketing collateral, including brochures, flyers, and advertisements, for a variety of clients","Developed and maintained company websites, improving user experience and increasing traffic by 25%","Collaborated with the marketing team to create visually appealing and effective email campaigns","Assisted in the development of brand guidelines and ensured consistency across all marketing materials","Utilized feedback from clients to refine and improve design concepts"],"companyLogo":"","description":"undefined","link":"","location":"Hamra, Beirut, Lebanon","position":"Graphic Designer","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":false,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"InfoPro","height":154,"id":"edoy1pyk9j","record":"ExperienceItem"}],"name":"","record":"ExperienceSection"},{"__t":"EducationSection","showCompanyLogos":false,"timelineWidth":175,"column":0,"enabled":true,"height":30,"items":[{"dateRange":{"fromMonth":4,"fromYear":2004,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":4,"toYear":2004},"alignment":"left","bullets":[],"companyLogo":"","degree":"Masters of Fine Arts in Graphic Design","gpa":"","gpaText":"","institution":"Oklahoma City univercity","location":"Oklahoma, US","maxGpa":"","showBullets":false,"showDateRange":true,"showGpa":false,"showLocation":true,"height":56,"id":"8vu8xck05b","record":"EducationItem"}],"name":"","record":"EducationSection"},{"__t":"SummarySection","showTitle":true,"column":1,"enabled":true,"height":30,"items":[{"alignment":"left","text":"Highly creative and multitalented Senior Graphic Designer with over 14 years of experience in multimedia, marketing, and print design. Exceptional collaborative and interpersonal skills; dynamic team player with well-developed written and verbal communication abilities. Highly skilled in client and vendor relations and negotiations; talented at building and maintaining \"win-win\" partnerships. Passionate and inventive creator of innovative marketing strategies and campaigns; accustomed to performing in deadline-driven environments with an emphasis on working within budget requirements.","height":94,"id":"guo4nk6u33","record":"SummaryItem"}],"name":"","record":"SummarySection"},{"__t":"TechnologySection","compactMode":false,"surroundingBorder":false,"column":1,"enabled":true,"height":30,"items":[{"description":"","showTitle":false,"tags":["Adobe After Effects","Adobe Creative Suite","Adobe Illustrator","Adobe Indesign","Adobe Photoshop","Adobe Premiere","Adobe Premiere Pro","Adobe XD","After Effects","Animation","Graphic Design","Indesign","Interface Design","Market Research","Motion Graphics","Photoshop","Premiere Pro","Typography","UI/UX","UI/UX Design","User Interface Design","Video Editing"],"title":"","height":178,"id":"tnilizfkjq","record":"TechnologyItem"}],"name":"","record":"TechnologySection"},{"__t":"ActivitySection","column":1,"enabled":true,"height":30,"items":[{"dateRange":{"fromMonth":null,"fromYear":null,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":null,"toYear":null},"alignment":"left","bullets":[""],"description":"","link":"","location":"","showBullets":true,"showDateRange":true,"showDescription":true,"showLink":false,"showLocation":true,"title":"","height":92,"id":"kvvs1kcr5q","record":"ActivityItem"}],"name":"","record":"ActivitySection"},{"__t":"PassionSection","showIcons":true,"column":1,"enabled":true,"height":30,"items":[{"alignment":"left","description":"","icon":"139-free-diamond-01","showDescription":false,"title":"","height":34,"id":"5iog19jnuv","record":"PassionItem"}],"name":"","record":"PassionSection"}],